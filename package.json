{
  "name": "score-analyse",
  "productName": "Table d’analyse",
  "version": "2.3.5",
  "description": "Table d'analyse musicale (ScoreSuite) — application Electron",
  "type": "module",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "decoupe": "electron main/cutter/cli.js",
    "dist:mac": "electron-builder --mac --dir --arm64",
    "test": "node tests/run.mjs"
  },
  "author": "Philippe Perret",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "image-size": "^2.1.0",
    "js-yaml": "^5.5.0",
    "pdfjs-dist": "^5.4.296"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.philippeperret.table-analyse",
    "productName": "Table Analyse",
    "icon": "assets/icons/icon.png",
    "files": [
      "main/**",
      "renderer/**",
      "assets/**",
      "locales/**",
      "VERSION",
      "package.json",
      "Manuels/Manuel/Manuel.html",
      "Manuels/Manuel/Manuel.epub",
      "Manuels/Manuel/Manuel.pdf"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "artifactName": "Table-Analyse-${version}.${ext}",
      "x64ArchFiles": "**/node_modules/@napi-rs/canvas-darwin-*/**",
      "extendInfo": {
        "CFBundleDisplayName": "Table d’analyse",
        "LSHasLocalizedDisplayName": true
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Table-Analyse-${version}.${ext}"
    },
    "nsis": {
      "shortcutName": "Table d’analyse",
      "uninstallDisplayName": "Table d’analyse"
    },
    "linux": {
      "executableName": "Table_analyse",
      "target": [
        "AppImage"
      ],
      "artifactName": "Table-Analyse-${version}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Table d’analyse"
        }
      }
    },
    "afterPack": "_scripts/build/afterPack.cjs"
  }
}
