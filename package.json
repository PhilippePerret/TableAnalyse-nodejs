{
  "name": "score-analyse",
  "productName": "Table d'analyse",
  "version": "3.0.0",
  "description": "Table d'analyse musicale (ScoreSuite) — application Electron",
  "type": "module",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --dir"
  },
  "author": "Philippe Perret",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "image-size": "^2.1.0",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.philippeperret.table-analyse",
    "icon": "assets/icons/icon.png",
    "files": [
      "main/**",
      "renderer/**",
      "assets/**",
      "VERSION",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
